#!/usr/bin/env bash
# wam — manage the wam-shell install: dependencies, updates, the running
# shell, and autostart. `wam install` clones the repo into WAM_HOME
# (~/.local/share/wam-shell) and copies this script into ~/.local/bin:
# after that the original clone can be deleted — update, lifecycle and
# autostart all work from the installed copy.
set -euo pipefail

WAM_HOME="${WAM_HOME:-$HOME/.local/share/wam-shell}"
REPO_URL="https://github.com/LeadSeason/wam-shell.git"
ROOT="$WAM_HOME"
SERVICE="wam-shell.service"
UNIT_DIR="$HOME/.config/systemd/user"
LOG_DIR="$HOME/.cache/wam-shell"
INSTANCE="wam-shell"

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() {
    printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
    exit 1
}

# `pnpm i`, but survivable when the user's pnpm cannot run on their node.
# pnpm 11 needs node >= 22.13 (it imports node:sqlite) and dies at
# startup on anything older with an ERR_UNKNOWN_BUILTIN_MODULE stack
# trace — before it ever reads the pnpm version this repo pins. That pin
# runs fine on node 18+, so corepack can do the install even when the
# pnpm on PATH cannot; only when both routes fail is it the user's turn
pnpm_install() {
    local pin
    pin="$(sed -n 's/.*"packageManager": *"\(pnpm@[^"]*\)".*/\1/p' "$ROOT/package.json")"

    if command -v pnpm >/dev/null && pnpm --version >/dev/null 2>&1; then
        (cd "$ROOT" && pnpm i) && return 0
        die "pnpm i failed — see the output above"
    fi

    local nodev
    nodev="$(node -v 2>/dev/null || echo "not found")"
    if [[ -n "$pin" ]] && command -v corepack >/dev/null; then
        log "pnpm cannot start on node $nodev — retrying with the pinned $pin via corepack"
        (cd "$ROOT" && corepack "$pin" i) && return 0
    fi

    die "pnpm cannot run on node $nodev.
  pnpm 11 requires node >= 22.13; this repo pins ${pin:-pnpm 10}, which runs on node 18+.
  Fix either side:
    - upgrade node (arch: sudo pacman -S nodejs), or
    - install the pinned pnpm: corepack enable && corepack install --global ${pin:-pnpm@10.28.1}"
}

usage() {
    cat <<EOF
usage: wam <command>

  install          clone into $WAM_HOME, install
                   dependencies + fonts there, and install wam itself into
                   ~/.local/bin — the invoking clone can then be deleted
                   (extra args are passed to scripts/setup.sh, e.g. --source)
  update           git fetch + fast-forward merge (upstream when set,
                   origin/master otherwise) + pnpm i
                   (restarts the service when active)
  start            start the shell (no-op when already running)
  stop             stop the shell
  restart          stop, then start
  force-start      kill EVERY ags instance, then start (stale-instance broom)
  autostart <enable|disable|status>
                   manage the systemd user service ($SERVICE)
  harvest setup    guided Harvest credentials setup (token, account id,
                   writes ~/.config/wam-shell/harvest.env, verifies)
  config <edit|path|show|diff|sync>
                   edit the config in $EDITOR (seeds the commented
                   template on first run), print its path, print it,
                   list template options your file predates (diff),
                   rewrite it as latest template + your values (sync)
  status           install, runtime and autostart state at a glance
  version          installed commit of the shell
EOF
}

require_install() {
    [[ -d "$ROOT/.git" ]] ||
        die "not installed — clone the repo and run: bash scripts/wam install"
}

running() { ags list 2>/dev/null | grep -qx "$INSTANCE"; }
service_enabled() { systemctl --user is-enabled "$SERVICE" &>/dev/null; }

start_detached() {
    mkdir -p "$LOG_DIR"
    log "Starting wam-shell (log: $LOG_DIR/shell.log)"
    (cd "$ROOT" && setsid nohup ags run app.tsx >"$LOG_DIR/shell.log" 2>&1 &)
}

# --- install / update ---------------------------------------------------------

cmd_install() {
    # populate the durable home: everything below runs from WAM_HOME, so
    # the clone this script was invoked from may be deleted afterwards.
    # also works piped (curl | bash): then there is no invoking repo at
    # all and the clone comes straight from upstream
    command -v git >/dev/null || die "git is required for install"

    local src=""
    src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd || true)"
    if [[ ! -d "$ROOT/.git" ]]; then
        # clone from the invoking repo's origin when there is one, else upstream
        local url="$REPO_URL"
        if [[ -n "$src" && -d "$src/.git" ]]; then
            url="$(git -C "$src" remote get-url origin 2>/dev/null || echo "$REPO_URL")"
        fi
        log "Cloning $url into $ROOT"
        git clone --branch master "$url" "$ROOT"
        # the durable home tracks upstream, not the bootstrap clone
        git -C "$ROOT" remote set-url origin "$REPO_URL"
    fi

    bash "$ROOT/scripts/setup.sh" "$@"

    log "Installing wam into ~/.local/bin (a copy — independent of any clone)"
    mkdir -p "$HOME/.local/bin"
    install -m 755 "$ROOT/scripts/wam" "$HOME/.local/bin/wam"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) log "NOTE: ~/.local/bin is not on PATH" ;;
    esac
    log "Done. Start now with: wam start — or autostart on login: wam autostart enable"
    log "The shell now lives in $ROOT; the clone may be deleted."
}

cmd_update() {
    require_install
    log "Pulling $ROOT"
    git -C "$ROOT" fetch origin || die "fetch failed"
    local branch upstream prev
    prev="$(git -C "$ROOT" rev-parse HEAD)"
    branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
    upstream="$(git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if [[ -n "$upstream" ]]; then
        git -C "$ROOT" merge --ff-only "$upstream" ||
            die "not fast-forward: $branch has diverged from $upstream"
    else
        # local feature branches usually have no upstream: sync with
        # master instead of failing with git's "no tracking information"
        log "No upstream for $branch — syncing with origin/master"
        git -C "$ROOT" merge --ff-only origin/master ||
            die "not fast-forward: $branch has commits not in origin/master — merge it yourself: git merge origin/master"
    fi
    # awareness: the update touched the config template -> there may be
    # new options the user's config predates
    if [[ -n "$(git -C "$ROOT" diff --name-only "$prev"..HEAD -- config.toml)" ]]; then
        log "The config template changed in this update — see what's new: wam config diff"
    fi
    log "pnpm i"
    pnpm_install
    if systemctl --user is-active "$SERVICE" &>/dev/null; then
        log "Restarting the service"
        systemctl --user restart "$SERVICE"
    elif running; then
        log "Shell is running outside the service — apply with: wam restart"
    fi
}

# --- lifecycle ------------------------------------------------------------------

cmd_start() {
    require_install
    if service_enabled; then
        systemctl --user start "$SERVICE"
        return
    fi
    if running; then
        log "already running"
        return
    fi
    start_detached
}

cmd_stop() {
    if service_enabled; then
        systemctl --user stop "$SERVICE"
        return
    fi
    if running; then
        ags quit -i "$INSTANCE" || true
    else
        log "not running"
    fi
}

cmd_restart() {
    require_install
    if service_enabled; then
        systemctl --user restart "$SERVICE"
        return
    fi
    if running; then
        ags quit -i "$INSTANCE" || true
        sleep 1
    fi
    start_detached
}

cmd_force_start() {
    require_install
    if service_enabled; then
        log "Stopping the service first (Restart=always would respawn it)"
        systemctl --user stop "$SERVICE"
    fi
    log "Quitting all ags instances"
    local inst
    for inst in $(ags list 2>/dev/null); do
        ags quit -i "$inst" 2>/dev/null || true
    done
    # anything that ignored the polite quit: the launcher and every gjs
    # bundle (perf/test instances included — that is the point).
    # Patterns are anchored: a bare substring also matches any wrapper
    # shell whose command line mentions "ags run app.tsx" (like the
    # caller of this very script) and pkill would kill it too
    pkill -f '^ags run app\.tsx' 2>/dev/null || true
    pkill -f "^gjs -m /run/user/$(id -u)/ags[.]js" 2>/dev/null || true
    sleep 1
    if service_enabled; then
        systemctl --user start "$SERVICE"
    else
        start_detached
    fi
}

# --- autostart ------------------------------------------------------------------

write_unit() {
    mkdir -p "$UNIT_DIR"
    # an empty ExecStart only surfaces as a dead service at next login
    command -v ags >/dev/null || die "ags not found in PATH"
    local target="graphical-session.target"
    systemctl --user list-units --type=target --no-legend 2>/dev/null | grep -q "$target" ||
        target="default.target"
    cat >"$UNIT_DIR/$SERVICE" <<EOF
[Unit]
Description=wam-shell (ags desktop shell)
After=$target
PartOf=$target

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$(command -v ags) run app.tsx
Restart=always
RestartSec=2

[Install]
WantedBy=$target
EOF
}

cmd_autostart() {
    case "${1:-}" in
        enable)
            require_install
            write_unit
            systemctl --user daemon-reload
            systemctl --user enable "$SERVICE"
            # make the CURRENT session's wayland env visible to services
            # started manually from now on (uwsm does this at login)
            systemctl --user import-environment \
                WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
                2>/dev/null || true
            log "Enabled (not started now — 'wam start' when ready, or it starts at login)"
            ;;
        disable)
            systemctl --user disable --now "$SERVICE" 2>/dev/null || true
            rm -f "$UNIT_DIR/$SERVICE"
            systemctl --user daemon-reload
            log "Disabled"
            ;;
        status)
            printf 'enabled: %s\n' "$(systemctl --user is-enabled "$SERVICE" 2>&1 || true)"
            printf 'active:  %s\n' "$(systemctl --user is-active "$SERVICE" 2>&1 || true)"
            [[ -f "$UNIT_DIR/$SERVICE" ]] &&
                grep -E 'WorkingDirectory|ExecStart' "$UNIT_DIR/$SERVICE" || true
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

# --- config ---------------------------------------------------------------------

# the file the shell reads first, following its search order (xdg user
# config, ~/.config fallback, then the repo copies)
active_config_file() {
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local candidates=(
        "$config_home/wam-shell/config.toml"
        "$HOME/.config/wam-shell/config.toml"
        "$ROOT/config-override.toml"
        "$ROOT/config.toml"
    )
    local c
    for c in "${candidates[@]}"; do
        [[ -f "$c" ]] && {
            printf '%s\n' "$c"
            return
        }
    done
    printf '%s\n' "${candidates[0]}"
}

cmd_config() {
    case "${1:-}" in
        edit) cmd_config_edit ;;
        path) cmd_config_path ;;
        show) cmd_config_show ;;
        diff) cmd_config_diff ;;
        sync) cmd_config_sync ;;
        *) die "usage: wam config <edit|path|show|diff|sync>" ;;
    esac
}

cmd_config_path() {
    active_config_file
}

cmd_config_show() {
    local f
    f="$(active_config_file)"
    if [[ -f "$f" ]]; then
        log "$f"
        cat "$f"
    else
        log "no config file — running on defaults. create one with: wam config edit"
    fi
}

cmd_config_edit() {
    require_install # the commented template ships with the install
    local config_home dir file
    config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    dir="$config_home/wam-shell"
    file="$dir/config.toml"
    if [[ ! -f "$file" ]]; then
        mkdir -p "$dir"
        cp "$ROOT/config.toml" "$file"
        log "Created $file from the commented template"
    fi
    local editor="${EDITOR:-${VISUAL:-}}"
    if [[ -z "$editor" ]]; then
        local e
        for e in nano vim vi; do
            command -v "$e" >/dev/null && {
                editor="$e"
                break
            }
        done
    fi
    [[ -n "$editor" ]] || die "no editor found — set \$EDITOR"
    # unquoted: allows "code --wait" style EDITOR values
    $editor "$file"
    log "Most options apply on restart: wam restart"
}

cmd_config_diff() {
    require_install # diffs against the install's template
    local f
    f="$(active_config_file)"
    [[ -f "$f" ]] || die "no user config yet — run: wam config edit"
    if [[ "$f" == "$ROOT/config.toml" || "$f" == "$ROOT/config-override.toml" ]]; then
        log "your active config IS the install's copy ($f) — always current, nothing to diff"
        return
    fi

    # template options the user file never mentions (commented or not),
    # grouped by section; each key listed once
    local missing=0 section printed_section="" key
    while IFS=$'\t' read -r section key; do
        [[ -z "$key" ]] && continue
        grep -qE "^[[:space:]]*#?[[:space:]]*${key}[[:space:]]*=" "$f" && continue
        if [[ "$section" != "$printed_section" ]]; then
            printf '  %s\n' "$section"
            printed_section="$section"
        fi
        printf '    %s\n' "$key"
        missing=$((missing + 1))
    done < <(awk '
        /^# ═/ { s = "(top level)"; next }
        /^# \[/ { s = $0; sub(/^# */, "", s); next }
        /^# [a-z_]+[ \t]*=/ {
            line = $0; sub(/^# */, "", line)
            split(line, a, /[ \t]/)
            if (!(a[1] in seen)) {
                seen[a[1]] = 1
                print (s == "" ? "(top level)" : s) "\t" a[1]
            }
        }
    ' "$ROOT/config.toml")

    if [[ "$missing" -eq 0 ]]; then
        log "$f mentions every option in the template"
    else
        log "$missing option(s) above are new since your config was written (details in $ROOT/config.toml; merge them in with: wam config sync)"
    fi
}

cmd_config_sync() {
    require_install # the new template ships with the install
    local f
    f="$(active_config_file)"
    [[ -f "$f" ]] || die "no user config yet — run: wam config edit"
    if [[ "$f" == "$ROOT/config.toml" || "$f" == "$ROOT/config-override.toml" ]]; then
        die "your active config IS the install's copy ($f) — create a user config first: wam config edit"
    fi

    # the config-override pattern: latest template + the user's active
    # values appended. the template is all comments, so the appended
    # sections never collide with it
    local values backup
    backup="$f.bak"
    values="$(grep -vE '^[[:space:]]*(#|$)' "$f" || true)"
    cp "$f" "$backup"
    cp "$ROOT/config.toml" "$f"
    if [[ -n "$values" ]]; then
        {
            printf '\n# --- your values (preserved by wam config sync, %s) ---\n' "$(date +%F)"
            printf '%s\n' "$values"
        } >>"$f"
    fi
    log "Synced $f with the latest template (backup: $backup)"
    log "Review with: wam config edit — most options apply on restart: wam restart"
}

# --- harvest -------------------------------------------------------------------

cmd_harvest() {
    case "${1:-}" in
        setup) cmd_harvest_setup ;;
        *) die "usage: wam harvest setup" ;;
    esac
}

cmd_harvest_setup() {
    command -v curl >/dev/null || die "curl is required for credential verification"

    local env_dir env_file
    env_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wam-shell"
    env_file="$env_dir/harvest.env"

    if [[ -f "$env_file" ]]; then
        local existing
        existing="$(grep -oE '^HARVEST_ACCOUNT_ID=.*' "$env_file" 2>/dev/null | head -1)"
        log "Existing credentials found ($existing)"
        read -r -p "Replace them? [y/N] " replace
        [[ "$replace" =~ ^[Yy] ]] || {
            log "Kept existing credentials"
            return
        }
    fi

    cat <<'EOF'

  1. Open https://id.getharvest.com/developers (sign in if asked)
  2. Choose "Create New Personal Access Token", name it e.g. wam-shell
  3. Copy the token, and the account id shown next to it

EOF
    read -r -p "Press Enter when you have both... "

    local token account
    read -r -s -p "Personal Access Token: " token
    echo
    read -r -p "Account ID: " account

    [[ -n "$token" ]] || die "token must not be empty"
    [[ "$account" =~ ^[0-9]+$ ]] || die "account id must be numeric"

    log "Verifying with the Harvest API…"
    local response code
    response="$(curl -sS --max-time 15 \
        -H "Authorization: Bearer $token" \
        -H "Harvest-Account-Id: $account" \
        -H "User-Agent: wam-shell" \
        -w '\n%{http_code}' \
        https://api.harvestapp.com/v2/users/me)" || die "could not reach the Harvest API"
    code="${response##*$'\n'}"
    response="${response%$'\n'*}"

    if [[ "$code" != "200" ]]; then
        die "verification failed (HTTP $code) — check the token and account id and run again"
    fi
    local name
    name="$(printf '%s' "$response" | grep -oE '"first_name":"[^"]*"' | cut -d'"' -f4) $(printf '%s' "$response" | grep -oE '"last_name":"[^"]*"' | cut -d'"' -f4)"

    # write with owner-only permissions from the start
    mkdir -p "$env_dir"
    (umask 077 && printf 'HARVEST_TOKEN=%s\nHARVEST_ACCOUNT_ID=%s\n' "$token" "$account" >"$env_file")
    chmod 600 "$env_file"

    log "Verified — signed in as ${name:-unknown}. Credentials written to $env_file (mode 600)"
    cat <<EOF

  Last step: enable the widget in your config:

      [harvest]
      enabled = true

  Then restart the shell: wam restart
EOF
}

# --- status / version -----------------------------------------------------------

cmd_status() {
    if [[ -d "$ROOT/.git" ]]; then
        printf 'installed: %s\n' "$(git -C "$ROOT" log -1 --format='%h %s (%cs)')"
        printf 'home:      %s\n' "$ROOT"
        local dirty
        dirty="$(git -C "$ROOT" status --porcelain | wc -l)"
        ((dirty > 0)) && printf 'dirty:     %s modified file(s)\n' "$dirty"
    else
        printf 'installed: no (%s missing)\n' "$ROOT"
    fi
    if [[ -L "$HOME/.local/bin/wam" ]]; then
        printf 'wam:       %s -> %s (symlink)\n' \
            "$HOME/.local/bin/wam" "$(readlink "$HOME/.local/bin/wam")"
    elif [[ -f "$HOME/.local/bin/wam" ]]; then
        printf 'wam:       %s\n' "$HOME/.local/bin/wam"
    else
        printf 'wam:       not installed (~/.local/bin/wam missing)\n'
    fi
    if running; then
        printf 'shell:     running (instance %s)\n' "$INSTANCE"
    else
        printf 'shell:     not running\n'
    fi
    printf 'autostart: %s / %s\n' \
        "$(systemctl --user is-enabled "$SERVICE" 2>&1 || true)" \
        "$(systemctl --user is-active "$SERVICE" 2>&1 || true)"
}

cmd_version() {
    if [[ ! -d "$ROOT/.git" ]]; then
        echo "wam-shell: not installed"
        return
    fi
    local hash branch date dirty
    hash="$(git -C "$ROOT" rev-parse --short HEAD)"
    branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
    date="$(git -C "$ROOT" log -1 --format=%cs)"
    dirty="$(git -C "$ROOT" status --porcelain | head -1)"
    echo "wam-shell $hash ($branch, $date)${dirty:+, dirty}"
}

# --- dispatch -------------------------------------------------------------------

case "${1:-}" in
    install)
        shift
        cmd_install "$@"
        ;;
    update) cmd_update ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    force-start) cmd_force_start ;;
    autostart)
        shift
        cmd_autostart "$@"
        ;;
    harvest)
        shift
        cmd_harvest "$@"
        ;;
    config)
        shift
        cmd_config "$@"
        ;;
    status) cmd_status ;;
    version) cmd_version ;;
    "")
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
