#!/usr/bin/env bash
# wam — manage the wam-shell install: dependencies, updates, the running
# shell, and autostart. `wam install` clones the repo into WAM_HOME
# (~/.local/share/wam-shell) and copies this script into ~/.local/bin:
# after that the original clone can be deleted — update, lifecycle and
# autostart all work from the installed copy.
set -euo pipefail

WAM_HOME="${WAM_HOME:-$HOME/.local/share/wam-shell}"
REPO_URL="https://github.com/LeadSeason/wam-shell.git"
ROOT="$WAM_HOME"
SERVICE="wam-shell.service"
UNIT_DIR="$HOME/.config/systemd/user"
LOG_DIR="$HOME/.cache/wam-shell"
INSTANCE="wam-shell"

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() {
    printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: wam <command>

  install          clone into $WAM_HOME, install
                   dependencies + fonts there, and install wam itself into
                   ~/.local/bin — the invoking clone can then be deleted
                   (extra args are passed to scripts/setup.sh, e.g. --source)
  update           git fetch + fast-forward merge (upstream when set,
                   origin/master otherwise) + pnpm i
                   (restarts the service when active)
  start            start the shell (no-op when already running)
  stop             stop the shell
  restart          stop, then start
  force-start      kill EVERY ags instance, then start (stale-instance broom)
  autostart <enable|disable|status>
                   manage the systemd user service ($SERVICE)
  status           install, runtime and autostart state at a glance
  version          installed commit of the shell
EOF
}

require_install() {
    [[ -d "$ROOT/.git" ]] ||
        die "not installed — clone the repo and run: bash scripts/wam install"
}

running() { ags list 2>/dev/null | grep -qx "$INSTANCE"; }
service_enabled() { systemctl --user is-enabled "$SERVICE" &>/dev/null; }

start_detached() {
    mkdir -p "$LOG_DIR"
    log "Starting wam-shell (log: $LOG_DIR/shell.log)"
    (cd "$ROOT" && setsid nohup ags run app.tsx >"$LOG_DIR/shell.log" 2>&1 &)
}

# --- install / update ---------------------------------------------------------

cmd_install() {
    # populate the durable home: everything below runs from WAM_HOME, so
    # the clone this script was invoked from may be deleted afterwards
    local src
    src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    if [[ "$src" != "$ROOT" && ! -d "$ROOT/.git" ]]; then
        # clone from the invoking repo's origin when available, else upstream
        local url
        url="$(git -C "$src" remote get-url origin 2>/dev/null || echo "$REPO_URL")"
        log "Cloning $url into $ROOT"
        git clone --branch master "$url" "$ROOT"
        # the durable home tracks upstream, not the bootstrap clone
        git -C "$ROOT" remote set-url origin "$REPO_URL"
    fi

    bash "$ROOT/scripts/setup.sh" "$@"

    log "Installing wam into ~/.local/bin (a copy — independent of any clone)"
    mkdir -p "$HOME/.local/bin"
    install -m 755 "$ROOT/scripts/wam" "$HOME/.local/bin/wam"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) log "NOTE: ~/.local/bin is not on PATH" ;;
    esac
    log "Done. Start now with: wam start — or autostart on login: wam autostart enable"
    log "The shell now lives in $ROOT; the clone may be deleted."
}

cmd_update() {
    require_install
    log "Pulling $ROOT"
    git -C "$ROOT" fetch origin || die "fetch failed"
    local branch upstream
    branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
    upstream="$(git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if [[ -n "$upstream" ]]; then
        git -C "$ROOT" merge --ff-only "$upstream" ||
            die "not fast-forward: $branch has diverged from $upstream"
    else
        # local feature branches usually have no upstream: sync with
        # master instead of failing with git's "no tracking information"
        log "No upstream for $branch — syncing with origin/master"
        git -C "$ROOT" merge --ff-only origin/master ||
            die "not fast-forward: $branch has commits not in origin/master — merge it yourself: git merge origin/master"
    fi
    log "pnpm i"
    (cd "$ROOT" && pnpm i)
    if systemctl --user is-active "$SERVICE" &>/dev/null; then
        log "Restarting the service"
        systemctl --user restart "$SERVICE"
    elif running; then
        log "Shell is running outside the service — apply with: wam restart"
    fi
}

# --- lifecycle ------------------------------------------------------------------

cmd_start() {
    require_install
    if service_enabled; then
        systemctl --user start "$SERVICE"
        return
    fi
    if running; then
        log "already running"
        return
    fi
    start_detached
}

cmd_stop() {
    if service_enabled; then
        systemctl --user stop "$SERVICE"
        return
    fi
    if running; then
        ags quit -i "$INSTANCE" || true
    else
        log "not running"
    fi
}

cmd_restart() {
    require_install
    if service_enabled; then
        systemctl --user restart "$SERVICE"
        return
    fi
    if running; then
        ags quit -i "$INSTANCE" || true
        sleep 1
    fi
    start_detached
}

cmd_force_start() {
    require_install
    if service_enabled; then
        log "Stopping the service first (Restart=always would respawn it)"
        systemctl --user stop "$SERVICE"
    fi
    log "Quitting all ags instances"
    local inst
    for inst in $(ags list 2>/dev/null); do
        ags quit -i "$inst" 2>/dev/null || true
    done
    # anything that ignored the polite quit: the launcher and every gjs
    # bundle (perf/test instances included — that is the point).
    # Patterns are anchored: a bare substring also matches any wrapper
    # shell whose command line mentions "ags run app.tsx" (like the
    # caller of this very script) and pkill would kill it too
    pkill -f '^ags run app\.tsx' 2>/dev/null || true
    pkill -f "^gjs -m /run/user/$(id -u)/ags[.]js" 2>/dev/null || true
    sleep 1
    if service_enabled; then
        systemctl --user start "$SERVICE"
    else
        start_detached
    fi
}

# --- autostart ------------------------------------------------------------------

write_unit() {
    mkdir -p "$UNIT_DIR"
    local target="graphical-session.target"
    systemctl --user list-units --type=target --no-legend 2>/dev/null | grep -q "$target" ||
        target="default.target"
    cat >"$UNIT_DIR/$SERVICE" <<EOF
[Unit]
Description=wam-shell (ags desktop shell)
After=$target
PartOf=$target

[Service]
Type=simple
WorkingDirectory=$ROOT
ExecStart=$(command -v ags) run app.tsx
Restart=always
RestartSec=2

[Install]
WantedBy=$target
EOF
}

cmd_autostart() {
    case "${1:-}" in
        enable)
            require_install
            write_unit
            systemctl --user daemon-reload
            systemctl --user enable "$SERVICE"
            # make the CURRENT session's wayland env visible to services
            # started manually from now on (uwsm does this at login)
            systemctl --user import-environment \
                WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
                2>/dev/null || true
            log "Enabled (not started now — 'wam start' when ready, or it starts at login)"
            ;;
        disable)
            systemctl --user disable --now "$SERVICE" 2>/dev/null || true
            rm -f "$UNIT_DIR/$SERVICE"
            systemctl --user daemon-reload
            log "Disabled"
            ;;
        status)
            printf 'enabled: %s\n' "$(systemctl --user is-enabled "$SERVICE" 2>&1 || true)"
            printf 'active:  %s\n' "$(systemctl --user is-active "$SERVICE" 2>&1 || true)"
            [[ -f "$UNIT_DIR/$SERVICE" ]] &&
                grep -E 'WorkingDirectory|ExecStart' "$UNIT_DIR/$SERVICE" || true
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

# --- status / version -----------------------------------------------------------

cmd_status() {
    if [[ -d "$ROOT/.git" ]]; then
        printf 'installed: %s\n' "$(git -C "$ROOT" log -1 --format='%h %s (%cs)')"
        printf 'home:      %s\n' "$ROOT"
        local dirty
        dirty="$(git -C "$ROOT" status --porcelain | wc -l)"
        ((dirty > 0)) && printf 'dirty:     %s modified file(s)\n' "$dirty"
    else
        printf 'installed: no (%s missing)\n' "$ROOT"
    fi
    if [[ -L "$HOME/.local/bin/wam" ]]; then
        printf 'wam:       %s -> %s (symlink)\n' \
            "$HOME/.local/bin/wam" "$(readlink "$HOME/.local/bin/wam")"
    elif [[ -f "$HOME/.local/bin/wam" ]]; then
        printf 'wam:       %s\n' "$HOME/.local/bin/wam"
    else
        printf 'wam:       not installed (~/.local/bin/wam missing)\n'
    fi
    if running; then
        printf 'shell:     running (instance %s)\n' "$INSTANCE"
    else
        printf 'shell:     not running\n'
    fi
    printf 'autostart: %s / %s\n' \
        "$(systemctl --user is-enabled "$SERVICE" 2>&1 || true)" \
        "$(systemctl --user is-active "$SERVICE" 2>&1 || true)"
}

cmd_version() {
    if [[ ! -d "$ROOT/.git" ]]; then
        echo "wam-shell: not installed"
        return
    fi
    local hash branch date dirty
    hash="$(git -C "$ROOT" rev-parse --short HEAD)"
    branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
    date="$(git -C "$ROOT" log -1 --format=%cs)"
    dirty="$(git -C "$ROOT" status --porcelain | head -1)"
    echo "wam-shell $hash ($branch, $date)${dirty:+, dirty}"
}

# --- dispatch -------------------------------------------------------------------

case "${1:-}" in
    install)
        shift
        cmd_install "$@"
        ;;
    update) cmd_update ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    force-start) cmd_force_start ;;
    autostart)
        shift
        cmd_autostart "$@"
        ;;
    status) cmd_status ;;
    version) cmd_version ;;
    "")
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
