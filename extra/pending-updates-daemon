#!/bin/bash
set -euo pipefail

# Mirror the shell's cache-dir resolution (GLib.get_user_cache_dir():
# $XDG_CACHE_HOME, else ~/.cache). Never fall back to /tmp: a
# predictable world-writable path is a symlink/planted-content hazard
# on shared machines.
#
# The instance name is a flat top-level key in the user's config —
# Config.instanceCacheDir is <cache>/<instance_name>, so a renamed
# instance reads a subdir nothing else writes. Parse it the way
# scripts/wam's resolve_instance_paths does: sed, no toml reader, last
# assignment wins, comment lines cannot match.
INSTANCE="wam-shell"
for f in "${XDG_CONFIG_HOME:-$HOME/.config}/wam-shell/config.toml" \
    "$HOME/.config/wam-shell/config.toml"; do
    if [[ -r "$f" ]]; then
        name="$(sed -n \
            -e 's/^[[:space:]]*instance_name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
            -e "s/^[[:space:]]*instance_name[[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" \
            "$f" | tail -1)"
        if [[ -n "$name" ]]; then
            INSTANCE="$name"
        fi
        break
    fi
done

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$INSTANCE"
mkdir -p "$CACHE_DIR"

UPDATE_FILE="$CACHE_DIR/system_updates"

echo "Updates listed in $UPDATE_FILE"

while true; do
    # Checkupdates provided by pacman-contrib. Both probes exit
    # non-zero when there is nothing to report (or the tool is
    # missing): keep the loop alive and write what we got.
    checkupdates > "$UPDATE_FILE.swap" 2> /dev/null || true
    yay -Qau >> "$UPDATE_FILE.swap" 2> /dev/null || true

    # atomic rename: readers never see a partially written list
    mv "$UPDATE_FILE.swap" "$UPDATE_FILE"

    echo "Available packages to update $(wc -l < "$UPDATE_FILE")"
    sleep 3600
done
